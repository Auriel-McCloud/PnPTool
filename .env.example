NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

JWT_SECRET=change-me-to-a-long-random-string

CORS_ORIGINS=["http://localhost:5173"]

# --- KI-Integration (Ideenschmiede) -------------------------------------
# Nur einer der beiden Keys wird gebraucht — welcher Anbieter aktiv ist,
# bestimmt KI_PROVIDER. Ohne Key funktioniert das restliche Tool normal,
# nur die "✨ KI"-Knöpfe in der Ideenschmiede melden einen Fehler.

# Google Gemini (generativelanguage.googleapis.com) — Key holen unter
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Mistral AI ("La Plateforme", api.mistral.ai) — Alternative zu Gemini,
# z.B. wenn dessen Kontingent aufgebraucht ist. Key holen unter
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# "gemini" oder "mistral" — welcher der beiden oben aktiv ist.
KI_PROVIDER=gemini

# --- Spotify Web API -----------------------------------------------------
# Playlist an Ort/Event hinterlegen, Musik folgt der aktiven Party (docs/api/spotify.md).
# Ohne Keys funktioniert das restliche Tool normal, nur "Mit Spotify verbinden" schlägt fehl.
#
# 1. App anlegen: https://developer.spotify.com/dashboard
# 2. In den App-Settings unter "Redirect URIs" GENAU die Zeile unten eintragen
#    (Spotify verlangt eine echte Loopback-IP statt "localhost").
# 3. Client-ID/-Secret von der App hierher kopieren.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8001/api/spotify/callback
