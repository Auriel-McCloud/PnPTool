rohnen AS maxDrohnen,\n    g.wVerlust AS wVerlust, g.koerperzone AS koerperzone,\n    g.slot AS slot, g.istWaffe AS istWaffe, g.schaden AS schaden,\n    g.traitBoni AS traitBoni, g.ausruestungsfertigkeiten AS ausruestungsfertigkeiten,\n    g.initiativeBonus AS initiativeBonus, g.verbaut AS verbaut,\n    g.entfernungBeantragt AS entfernungBeantragt,\n    g.zusatzaktionen AS zusatzaktionen,\n    g.weggeworfen AS weggeworfen, g.weggeworfenVon AS weggeworfenVon,\n    g.ablage AS ablage,\n    g.ruestungKaestchenMax AS ruestungKaestchenMax, g.ruestungKaestchenAktuell AS ruestungKaestchenAktuell,\n    g.ruestungReduktionBasis AS ruestungReduktionBasis,\n    g.istReparaturmaterial AS istReparaturmaterial, g.reparaturKapazitaet AS reparaturKapazitaet,\n    ziel.id AS ablageZielId, coalesce(ziel.name, ziel.title) AS ablageZielName,\n    CASE WHEN ziel IS NULL THEN NULL ELSE labels(ziel)[0] END AS ablageZielKind\n, p.id AS ownerId, p.name AS ownerName, p.personType AS ownerPersonType\n        ORDER BY p.name, g.name\n    '
